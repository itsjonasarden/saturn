#!/bin/sh
# Sends one Claude Code hook event (its JSON on stdin) to the Akyba window this session runs in,
# and prints Akyba's answer, if any, for Claude Code to read. Outside Akyba it does nothing.
[ -n "$AKYBA_SOCKET" ] && [ -S "$AKYBA_SOCKET" ] || exit 0
curl --silent --max-time 2 --unix-socket "$AKYBA_SOCKET" \
  --header 'Content-Type: application/json' --data-binary @- \
  "http://akyba/hook?pane=${AKYBA_PANE_ID}" 2>/dev/null
exit 0

#!/bin/sh
# Codex runs this as each of its turns ends (the `notify` of Akyba's Codex profile), with the turn
# as JSON in $1: its session's id, folder and last answer. It goes to the Akyba window the session
# runs in. Outside Akyba it does nothing.
[ -n "$AKYBA_SOCKET" ] && [ -S "$AKYBA_SOCKET" ] || exit 0
printf '%s' "$1" | curl --silent --max-time 2 --unix-socket "$AKYBA_SOCKET" \
  --header 'Content-Type: application/json' --data-binary @- \
  "http://akyba/hook?pane=${AKYBA_PANE_ID}&agent=codex" >/dev/null 2>&1
exit 0
